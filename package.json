{
  "name": "dsh-launcher",
  "version": "1.0.25",
  "private": true,
  "description": "A local desktop launcher and plugin organizer for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "launcher",
    "electron",
    "plugin",
    "modpack"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rirko/dsh-melody-launcher.git"
  },
  "homepage": "https://github.com/rirko/dsh-melody-launcher#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node -e \"const fs=require('node:fs'),p=require('node:path'),n=require('./package.json').name+'-dev';for(const d of [p.join(process.env.APPDATA,n),p.join(process.env.LOCALAPPDATA,n,'dsh-packs')]){try{fs.rmSync(d,{recursive:true,force:true});console.log('dev:clean removed',d)}catch(e){console.log('dev:clean skipped (locked?)',d,e.code)}}\" && npm run dev",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "pack:official": "vite-node scripts/build-official-pack.mts",
    "fetch:runtimes": "vite-node scripts/fetch-node-runtime.mts",
    "archive:runtime": "vite-node scripts/build-node-archive.mts",
    "bundle:kernel": "vite-node scripts/bundle-kernel.mts",
    "selfcheck:snapshot": "vite-node scripts/selfcheck-pack-snapshot.mts",
    "selfcheck:verify": "vite-node scripts/selfcheck-pack-verify.mts",
    "export:offline": "vite-node scripts/export-offline-pack.mts",
    "package:win": "npm run build && electron-builder --win portable",
    "package:inno": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.14",
    "adm-zip": "^0.6.0",
    "koffi": "^3.1.5",
    "lucide-react": "^1.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.local.dshlauncher",
    "productName": "DSH Launcher",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@koromix/koffi-win32-x64/win32_x64",
        "to": "koffi/win32_x64"
      },
      {
        "from": "runtime/kernels",
        "to": "kernels"
      },
      {
        "from": "runtime",
        "to": "node-archive",
        "filter": [
          "node-runtime-*.zip"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ],
      "artifactName": "DSH-Launcher-${version}.${ext}"
    }
  }
}
